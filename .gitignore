# venti .gitignore
# linux-only terminal multiplexer · rust + ratatui
# rule of thumb: source and config are committed, everything generated is not.

# ─────────────────────────────────────────────
# rust / cargo — build artifacts
# ─────────────────────────────────────────────
target/
**/*.rs.bk
*.crate

# note: Cargo.lock is committed on purpose — venti is a binary and ci uses --locked.

# ─────────────────────────────────────────────
# release & packaging artifacts
# (releases are built in ci from tags; local runs must not be committed)
# ─────────────────────────────────────────────
/venti-*/
/venti-*.tar.gz
/venti-*.tar.gz.sha256
/release-notes.md
*.tar.gz
*.tgz
*.tar.bz2
*.tar
*.zip

# ─────────────────────────────────────────────
# tests — insta pending snapshots
# accepted snapshots (*.snap) are committed on purpose
# ─────────────────────────────────────────────
**/*.snap.new
**/*.snap.new.*

# ─────────────────────────────────────────────
# coverage & profiling
# ─────────────────────────────────────────────
*.profraw
*.profdata
*.gcno
*.gcda
lcov.info
cobertura.xml
tarpaulin-report.html
tarpaulin-report.json
coverage/
llvm-cov*/

# ─────────────────────────────────────────────
# core dumps & debug symbols (repo-root only, so src/server/core.rs stays)
# ─────────────────────────────────────────────
/core
/core.*
*.core
*.dSYM/
*.pdb

# ─────────────────────────────────────────────
# logs
# ─────────────────────────────────────────────
*.log
nohup.out

# ─────────────────────────────────────────────
# env & secrets — never commit credentials
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
!*.key.example
.envrc

# ─────────────────────────────────────────────
# os junk
# ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────
# editors & local tooling
# ─────────────────────────────────────────────
*~
*.swp
*.swo
*.swn
.*.sw?
*.sublime-project
*.sublime-workspace
*.iml
.idea/
.vscode/
.zed/
.cursor/
.aider*
.emacs.desktop
.*.un~

# ─────────────────────────────────────────────
# patch / merge artifacts
# ─────────────────────────────────────────────
*.orig
*.rej
*.bak
*.bak-*
*.LOCAL.*
*.REMOTE.*

# ─────────────────────────────────────────────
# caches & scratch
# ─────────────────────────────────────────────
.cache/
*.tmp
*.temp
.zcompdump*
.python-version

# ─────────────────────────────────────────────
# other stuff :)
# ─────────────────────────────────────────────
local/
